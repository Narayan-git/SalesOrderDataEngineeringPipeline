{
	"name": "pl_incremental_data_load",
	"properties": {
		"activities": [
			{
				"name": "lkp_last_load",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "SELECT Last_load FROM [dbo].[water_table]",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "ds_sql_db_sink",
						"type": "DatasetReference",
						"parameters": {
							"schema": "dbo",
							"table_name": "water_table"
						}
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "lkp_current_load",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "SELECT MAX(DATE_ID) AS CURRENT_DATE_ID FROM [dbo].[SOURCE_CARS_DATA]",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "ds_sql_db_sink",
						"type": "DatasetReference",
						"parameters": {
							"schema": "dbo",
							"table_name": "water_table"
						}
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "If Condition1",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "lkp_current_load",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "lkp_last_load",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@not(equals(activity('lkp_last_load').output.value[0].Last_load,\nactivity('lkp_current_load').output.value[0].CURRENT_DATE_ID))",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "sv_if_false_message",
							"type": "SetVariable",
							"dependsOn": [],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "message",
								"value": {
									"value": "Last Load value '@{activity('lkp_last_load').output.value[0].Last_load}' equals with Current load '@{activity('lkp_current_load').output.value[0].CURRENT_DATE_ID}' all the existing data was already loaded",
									"type": "Expression"
								}
							}
						}
					],
					"ifTrueActivities": [
						{
							"name": "cd_incremental_load",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "AzureSqlSource",
									"sqlReaderQuery": {
										"value": "SELECT *\nFROM [dbo].[SOURCE_CARS_DATA]\nWHERE DATE_ID > '@{activity('lkp_last_load').output.value[0].Last_load}'\nAND DATE_ID <= '@{activity('lkp_current_load').output.value[0].CURRENT_DATE_ID}'",
										"type": "Expression"
									},
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"sink": {
									"type": "ParquetSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "ParquetWriteSettings"
									}
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "ds_sql_db_sink",
									"type": "DatasetReference",
									"parameters": {
										"schema": "dbo",
										"table_name": "SOURCE_CARS_DATA"
									}
								}
							],
							"outputs": [
								{
									"referenceName": "ds_bronze",
									"type": "DatasetReference"
								}
							]
						},
						{
							"name": "sp_updatewater_mark",
							"type": "SqlServerStoredProcedure",
							"dependsOn": [
								{
									"activity": "cd_incremental_load",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"storedProcedureName": "[dbo].[update_water_table]",
								"storedProcedureParameters": {
									"load_id": {
										"value": {
											"value": "@activity('lkp_current_load').output.value[0].CURRENT_DATE_ID",
											"type": "Expression"
										},
										"type": "String"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "ls_sql_db",
								"type": "LinkedServiceReference"
							}
						},
						{
							"name": "Notebook1",
							"type": "DatabricksNotebook",
							"dependsOn": [
								{
									"activity": "sp_updatewater_mark",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"linkedServiceName": {
								"referenceName": "ls_databricks",
								"type": "LinkedServiceReference"
							}
						}
					]
				}
			}
		],
		"variables": {
			"message": {
				"type": "String"
			}
		},
		"annotations": []
	}
}